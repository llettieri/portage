{
  "name": "ext",
  "version": "0.2.0-0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare",
    "icons": "node scripts/generate-icons.ts",
    "dev:chrome": "wxt -b chrome",
    "dev:firefox": "wxt -b firefox",
    "build": "pnpm run build:chrome && pnpm run build:firefox && pnpm run zip:firefox",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "zip:firefox": "wxt zip -b firefox",
    "submit:firefox:dry-run": "wxt submit --dry-run --firefox-channel unlisted --firefox-extension-id portage@lettieri.dev --firefox-zip .output/ext-$npm_package_version-firefox.zip --firefox-sources-zip .output/ext-$npm_package_version-sources.zip",
    "submit:firefox": "wxt submit --firefox-channel unlisted --firefox-extension-id portage@lettieri.dev --firefox-zip .output/ext-$npm_package_version-firefox.zip --firefox-sources-zip .output/ext-$npm_package_version-sources.zip",
    "test": "tsc -p tsconfig.json && vitest run"
  },
  "dependencies": {
    "protocol": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@wxt-dev/module-react": "^1.2.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  }
}
